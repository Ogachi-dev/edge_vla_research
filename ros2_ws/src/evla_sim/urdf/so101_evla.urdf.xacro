<?xml version="1.0"?>
<!-- lerobot_ws の SO-101 に、TCP・手首カメラ・DetachableJoint・制御設定を足す（docs/track2/31 4.2）
     【要確認】include するファイル名とリンク名は lerobot_ws の実物に合わせる -->
<robot name="so101" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find lerobot_description)/urdf/so101_base.xacro"/>
  <xacro:include filename="$(find lerobot_description)/urdf/so101_ros2_control.xacro"/>
  <!-- so101_gazebo.xacro は include しない（コントローラYAMLのパスを差し替えるため） -->

  <!-- TCP：両爪先端の中間（閉じた状態）。値は 31章 Step 5 で求める -->
  <link name="tcp"/>
  <joint name="tcp_joint" type="fixed">
    <parent link="gripper"/>  <!-- 【穴①】爪の固定側が付いているリンク（lerobot_ws のリンク名） -->
    <child link="tcp"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>  <!-- TODO(you): 31章 Step 5 の結果 -->
  </joint>

  <!-- 手首カメラ -->
  <link name="wrist_camera_link"/>
  <joint name="wrist_camera_joint" type="fixed">
    <parent link="gripper"/>
    <child link="wrist_camera_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>  <!-- TODO(you): 実機の取り付け位置に近い値 -->
  </joint>
  <gazebo reference="wrist_camera_joint">
    <preserveFixedJoint>true</preserveFixedJoint>  <!-- 【穴②】固定関節をまとめて消さずに残す（消えるとセンサの親リンクが変わる） -->
  </gazebo>
  <gazebo reference="wrist_camera_link">
    <sensor name="wrist_camera" type="camera">
      <update_rate>30</update_rate>  <!-- 【穴③】画像の周期[Hz]（sim 時刻） -->
      <topic>/camera/wrist/image</topic>
      <camera>
        <camera_info_topic>/camera/wrist/camera_info</camera_info_topic>
        <horizontal_fov>1.2</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.01</near><far>3.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- 衝突マスク：爪とキューブだけ衝突しないようにする（31章 4.4）。
       TODO(you): gripper / jaw の collision に collide_bitmask 0x01 が入るか確かめる（31章 Step 6）。
       入らなければ render_world.py 側で SDF を後処理する -->

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find evla_sim)/config/controllers.yaml</parameters>
    </plugin>
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>gripper</parent_link>
      <child_model>cube</child_model>  <!-- 【穴④】world に置いたキューブのモデル名 -->
      <child_link>cube_link</child_link>
      <attach_topic>/grasp/attach</attach_topic>
      <detach_topic>/grasp/detach</detach_topic>
      <output_topic>/grasp/state</output_topic>
    </plugin>
  </gazebo>
</robot>
